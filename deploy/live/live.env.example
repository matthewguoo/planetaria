# /etc/planetaria/live.env — the LIVE server's whole environment.
#   sudo install -m 600 -o root -g <user> deploy/live/live.env.example /etc/planetaria/live.env
#   sudo nano /etc/planetaria/live.env    (fill the two keys)
#
# There is deliberately NO .env in the repo checkout on the live box: no
# paper keys, no LLM keys, nothing the live process does not need. Every
# line here is read by pydantic-settings as process env.

# --- the isolation contract (the app refuses to boot without all of it) ---
TRADING_MODE=live_manual
STRATEGIES_ENABLED=false
LIVE_ACCOUNT_NAME=live_roth
# Native postgres/redis on this box (default ports, unlike the Windows dev
# stack's 5433/6380). Both must differ from the paper defaults.
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader_live
REDIS_URL=redis://localhost:6379/1
# Never set ALPACA_PAPER: live mode derives it (false) and ignores env.

# --- the live account (AK... = live keys; PK... paper keys are refused) ---
ALPACA_ACCOUNT_LIVE_ROTH_API_KEY=AK...
ALPACA_ACCOUNT_LIVE_ROTH_SECRET_KEY=...

# --- data feeds (free tier is fine for a manual book) ---
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# A Postgres outage is a BOOT FAILURE here, never a silent empty SQLite
# store (zero monitors on real positions while /api/health still answers).
SQLITE_FALLBACK=false
