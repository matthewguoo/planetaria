# Alpaca (paper) — get keys at https://app.alpaca.markets/paper/dashboard/overview
# Without keys the engine boots but cannot price or trade (the keyless public
# fallback feed was removed 2026-08-05). This file is found from the repo root
# or backend/ regardless of where the server is launched.
ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
# Hard-locked to paper in v1; the app refuses to start with ALPACA_PAPER=false
ALPACA_PAPER=true

# Data feeds (free tier). Upgrade path: iex->sip, indicative->opra — config
# only. Persisted feed settings (SYSTEM page) override these at boot.
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# Additional named paper accounts for the ACCOUNT page's selector. The
# engine boots with the pair above; AccountService switches to a named
# pair at the next boot (paper-only, refused while plans are open).
#   ALPACA_ACCOUNT_<NAME>_API_KEY=...
#   ALPACA_ACCOUNT_<NAME>_SECRET_KEY=...

DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5433/trader
REDIS_URL=redis://localhost:6380/0

# HEADLESS=true boots the engine only: full execution stack plus the
# command/ops API, no UI-serving routes. STRATEGIES_ENABLED=false is the
# boot-time kill switch for the strategy runtime.
#HEADLESS=false
#STRATEGIES_ENABLED=true
#BAR_CACHE_DAYS=10
#CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM analysis gateway (ctx.analyze). No key = analyze() raises a clean
# AnalysisError; nothing else depends on it. LLM_BACKEND=claude-cli routes
# through the local Claude Code CLI on subscription auth instead.
#ANTHROPIC_API_KEY=
#LLM_BACKEND=api
#LLM_MODEL=claude-opus-5
#LLM_EFFORT=low

# Earnings data plane. EDGAR requires a real contact in the User-Agent
# (SEC fair-access rules); the calendar feed only starts with a Finnhub
# key (free tier: finnhub.io/register).
#EDGAR_USER_AGENT=planetaria/0.1 (contact: you@example.com)
#FINNHUB_API_KEY=

# Frontend (Vite reads VITE_* from frontend/.env; documented for reference.
# The console talks same-origin through the dev proxy, so it is normally
# unset.)
#VITE_API_URL=http://localhost:8000
