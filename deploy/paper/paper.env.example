# /etc/planetaria/paper.env - the WHOLE environment of the paper process on the
# box (root:mikoyae 0640). There is no .env in the checkout. Every key below is
# a Settings field (backend/app/config.py) or an Alpaca account-key pair;
# tests/test_env_examples.py refuses anything else (config ignores unknown
# keys silently, so a typo here would be a silently missing setting).

TRADING_MODE=paper
ALPACA_PAPER=true
STRATEGIES_ENABLED=true
SQLITE_FALLBACK=false

# Paper keys (PK...). The DB's persisted account selection is planetaria1,
# so that pair is REQUIRED - without it AccountService falls back to the
# unnamed default pair (loudly) at boot.
ALPACA_API_KEY=PK...
ALPACA_SECRET_KEY=...
ALPACA_ACCOUNT_PLANETARIA1_API_KEY=PK...
ALPACA_ACCOUNT_PLANETARIA1_SECRET_KEY=...

ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative

# Own stores: Postgres db trader (created by setup-paper.sh), redis db 0.
# Rollback = the copied SQLite snapshot kept OUTSIDE the checkout:
#   DATABASE_URL=sqlite+aiosqlite:////home/mikoyae/paper-store/trader.db
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trader
REDIS_URL=redis://localhost:6379/0

# Strategy LLM: the Claude CLI on the service user's subscription
# (install + `claude login` as that user). Alternative: LLM_BACKEND=api with
# ANTHROPIC_API_KEY (the old CLAUDE_API_KEY name was never read by the app).
LLM_BACKEND=claude-cli
LLM_MODEL=claude-fable-5
LLM_EFFORT=low
#ANTHROPIC_API_KEY=

# Earnings calendar + after-hours quote source; without it those feeds
# silently stay off.
FINNHUB_API_KEY=
#EDGAR_USER_AGENT=planetaria/0.1 (contact: you@example.com)
#BAR_CACHE_DAYS=10
